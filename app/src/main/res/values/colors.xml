<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Monero brand: the glass logo orange as the phone shows it, as ui/theme
         MoneroOrangeDay. values-night holds the night value (MoneroOrangeNight).
         Compose reads ui/theme; widgets and notifications read these. -->
    <color name="monero_orange">#FFFF7719</color>
    <!-- 15% brand orange: widget badge and sent-transaction icon fills. -->
    <color name="monero_orange_tint">#26FF7719</color>
    <!-- Pressed orange: 90% of each channel of monero_orange, as ui/theme
         MoneroOrangePressedDay. The XML themes use it as colorPrimaryDark. -->
    <color name="monero_orange_dark">#FFE66B17</color>

    <!-- Status colors (light values; Compose switches light/dark in ui/theme) -->
    <color name="success_green">#FF34C759</color>
    <color name="error_red">#FFFF383C</color>
    <color name="warning_yellow">#FFFFCC00</color>

    <!-- Background colors (iOS system neutrals) -->
    <color name="background_light">#FFFFFFFF</color>
    <color name="background_dark">#FF000000</color>
    <color name="surface_light">#FFFFFFFF</color>
    <color name="surface_dark">#FF1C1C1E</color>

</resources>
